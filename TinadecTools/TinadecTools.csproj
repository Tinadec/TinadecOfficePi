<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <BundledRipgrepFileName Condition="'$(BundledRipgrepFileName)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">rg.exe</BundledRipgrepFileName>
    <BundledRipgrepFileName Condition="'$(BundledRipgrepFileName)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">rg.exe</BundledRipgrepFileName>
    <BundledRipgrepFileName Condition="'$(BundledRipgrepFileName)' == ''">rg</BundledRipgrepFileName>
    <BundledRipgrepPath Condition="'$(BundledRipgrepPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../native/rg/$(BundledRipgrepFileName)'))</BundledRipgrepPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TinadecTools.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncReaderWriterLock" Version="1.0.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3"/>
    <PackageReference Include="System.IO.Hashing" Version="10.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinadecTools.Generators\TinadecTools.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Update="Nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(BundledRipgrepPath)" Condition="Exists('$(BundledRipgrepPath)')">
      <Link>$(BundledRipgrepFileName)</Link>
      <TargetPath>$(BundledRipgrepFileName)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateBundledRipgrep" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(BundledRipgrepPath)')"
           Text="Required bundled ripgrep binary is missing: '$(BundledRipgrepPath)'. Stage the platform ripgrep payload as $(BundledRipgrepFileName) at that path before Release builds or publishing; ordinary Debug builds may use TINADEC_TOOLS_RG_PATH or PATH." />
  </Target>

  <Target Name="ValidateBundledRipgrepForReleaseBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release'"
          DependsOnTargets="ValidateBundledRipgrep" />

  <Target Name="ValidateBundledRipgrepForPublish"
          BeforeTargets="Publish"
          DependsOnTargets="ValidateBundledRipgrep" />

</Project>
